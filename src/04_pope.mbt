// ============================================================================
// 04_pope.mbt -- PoPE position encodings and their unification.
//
// There are TWO constructions called "PoPE" in the literature:
//   (L) PoPE = Legendre Orthogonal Polynomial based Position Encoding
//       PE(pos, i) = P_pos(x_i), x_i equidistant in [-1,1]      [arXiv:2405.04585]
//   (P) PoPE = Polar Coordinate Position Embedding
//       a(t,s) = Σ_c μ_q(t,c) μ_k(s,c) cos((s-t)θ_c + δ_c)      [arXiv:2509.10534]
//
// ABSTRACTION / UNIFICATION (Theorem T7).  Both are SPECTRAL TRIPLES
// (A, H, J): the position algebra A is generated by a self-adjoint operator J
// acting on the encoding Hilbert space H.
//   (L) J = Jacobi (tridiagonal) matrix of the three-term recurrence
//       x P_n = a_n P_{n+1} + b_n P_n + a_{n-1} P_{n-1};  spec(J) = roots of P_N.
//   (P) J = diag(θ_1..θ_d);  spec(J) = the U(1)^d characters.
// In both cases the position kernel K = <Φ(pos), Φ(pos')> is the spectral
// measure of J, hence positive definite, and a linear operator (the
// recurrence / the phase rotation) recovers RELATIVE position.  For agents
// this means coupling depends on offsets, never on absolute coordinates.
// ============================================================================

///|
/// A position kernel is the pullback of a spectral measure along ℕ → ℝ.
pub trait PosKernel {
  fn eval(Self, Int32) -> Double
}

// ---------------------------------------------------------------------------
// (L) Legendre PoPE
// ---------------------------------------------------------------------------

///|
/// Coefficients of P_n via the Favard three-term recurrence
/// (n+1) P_{n+1} = (2n+1) x P_n - n P_{n-1}.
pub fn legendre_coeffs(n : Int32) -> Array[Double] {
  if n == 0 {
    return [1.0]
  }
  if n == 1 {
    return [0.0, 1.0]
  }
  let mut p0 : Array[Double] = [1.0]
  let mut p1 : Array[Double] = [0.0, 1.0]
  for k in 1..<n {
    let kd = k.to_double()
    let out = Array::make(k + 2, 0.0)
    for i in 0..<p1.length() {
      out[i + 1] += (2.0 * kd + 1.0) / (kd + 1.0) * p1[i]
    }
    for i in 0..<p0.length() {
      out[i] -= kd / (kd + 1.0) * p0[i]
    }
    p0 = p1
    p1 = out
  }
  p1
}

///|
pub fn poly_eval(c : Array[Double], x : Double) -> Double {
  let mut s = 0.0
  let mut p = 1.0
  for k in 0..<c.length() {
    s += c[k] * p
    p *= x
  }
  s
}

///|
pub fn poly_deriv_eval(c : Array[Double], x : Double) -> Double {
  let mut s = 0.0
  let mut p = 1.0
  for k in 1..<c.length() {
    s += k.to_double() * c[k] * p
    p *= x
  }
  s
}

///|
pub fn legendre(n : Int32, x : Double) -> Double {
  poly_eval(legendre_coeffs(n), x)
}

///|
pub(all) struct Quad {
  nodes : Array[Double]
  weights : Array[Double]
}

///|
/// Gauss-Legendre nodes/weights by Newton iteration on P_n (Algorithm A3).
/// Initial guesses cos(π(i+3/4)/(n+1/2));  weights 2/((1-x²) P_n'(x)²).
pub fn gauss_legendre(n : Int32) -> Quad {
  let c = legendre_coeffs(n)
  let nodes = Array::make(n, 0.0)
  let weights = Array::make(n, 0.0)
  for i in 0..<n {
    let mut x = @math.cos(
      @math.PI * (i.to_double() + 0.75) / (n.to_double() + 0.5),
    )
    for _ in 0..<64 {
      let dp = poly_deriv_eval(c, x)
      if dp == 0.0 {
        x += 1.0e-6
      } else {
        x -= poly_eval(c, x) / dp
      }
    }
    let dp = poly_deriv_eval(c, x)
    nodes[i] = x
    weights[i] = 2.0 / ((1.0 - x * x) * dp * dp)
  }
  Quad::{ nodes, weights, }
}

///|
/// PoPE-L: PE(pos, i) = P_pos(x_i), x_i equidistant in [-1,1] (Eq. 14 of 2405.04585).
pub fn pope_legendre_encoding(pos : Int32, d : Int32) -> Array[Double] {
  Array::makei(d, fn(i) {
    let x = -1.0 + 2.0 * i.to_double() / (d - 1).to_double()
    legendre(pos, x)
  })
}

///|
/// Discrete L² inner product under Gauss-Legendre quadrature.
pub fn legendre_gram(a : Int32, b : Int32, q : Quad) -> Double {
  let mut s = 0.0
  for k in 0..<q.nodes.length() {
    s += q.weights[k] * legendre(a, q.nodes[k]) * legendre(b, q.nodes[k])
  }
  s
}

///|
/// Jacobi matrix of the normalized Legendre recurrence (N x N tridiagonal).
/// off-diagonal_k = k / sqrt((2k-1)(2k+1)), diagonal = 0.
pub fn legendre_jacobi(n : Int32) -> Array[Double] {
  Array::makei(n * n, fn(t) {
    let i = t / n
    let j = t % n
    if i == j + 1 || j == i + 1 {
      let k = if i < j { i + 1 } else { j + 1 }
      k.to_double() / ((2 * k - 1).to_double() * (2 * k + 1).to_double()).sqrt()
    } else {
      0.0
    }
  })
}

///|
/// `det(J - x I)`, used to certify `spec(J) = roots of P_N`.
/// Delegates to the shared monic evaluator: `det(J - xI) = (-1)^n det(xI - J)`.
pub fn char_poly_at(j : Array[Double], n : Int32, x : Double) -> Double {
  let monic = char_poly_monic(j, n, x)
  if n % 2 == 0 {
    monic
  } else {
    -monic
  }
}

///|
pub(all) struct LegendrePoPE {
  dim : Int32
}

///|
pub impl PosKernel for LegendrePoPE with fn eval(_self, delta) {
  // L²-orthogonal kernel: <P_t, P_s> = 2/(2t+1) δ_{t,s}.
  // As a function of the offset it is the Kronecker delta at 0 (no absolute
  // position leakage), scaled by the first norm for convenience.
  if delta == 0 {
    2.0
  } else {
    0.0
  }
}

///|
pub extend LegendrePoPE with PosKernel::{eval}

// ---------------------------------------------------------------------------
// (P) Polar-coordinate PoPE
// ---------------------------------------------------------------------------

///|
pub fn softplus(x : Double) -> Double {
  let z = clamp(x, -30.0, 30.0)
  @math.ln(1.0 + @math.exp(z))
}

///|
pub(all) struct PolarPoPE {
  dim : Int32
  base : Double
  bias : Array[Double]
}

///|
pub fn PolarPoPE::new(dim : Int32, base : Double) -> PolarPoPE {
  PolarPoPE::{ dim, base, bias: Array::make(dim, 0.0), }
}

///|
pub impl PosKernel for PolarPoPE with fn eval(self, delta) {
  let mut s = 0.0
  for c in 0..<self.dim {
    let th = @math.pow(self.base, c.to_double() / self.dim.to_double())
    s += @math.cos(delta.to_double() * th + self.bias[c])
  }
  s / self.dim.to_double()
}

///|
pub extend PolarPoPE with PosKernel::{eval}

///|
/// PoPE attention score: Σ_c μ_q μ_k cos((s-t)θ_c + δ_c).
/// μ are softplus magnitudes ("what"); the phase is pure position ("where").
pub fn pope_score(
  qmag : Array[Double],
  kmag : Array[Double],
  delta : Int32,
  base : Double,
  bias : Array[Double],
) -> Double {
  let d = qmag.length()
  let mut s = 0.0
  for c in 0..<d {
    let th = @math.pow(base, c.to_double() / d.to_double())
    s += qmag[c] * kmag[c] * @math.cos(delta.to_double() * th + bias[c])
  }
  s
}

///|
/// RoPE score in 2D: qᵀ R(Δθ) k.  Contains the content-cross-term q ∧ k.
pub fn rope_2d_score(
  q : Array[Double],
  k : Array[Double],
  delta : Int32,
  theta : Double,
) -> Double {
  let a = delta.to_double() * theta
  let c = @math.cos(a)
  let s = @math.sin(a)
  q[0] * (c * k[0] - s * k[1]) + q[1] * (s * k[0] + c * k[1])
}

///|
/// PoPE score in 2D (decoupled): magnitudes only, no content phase.
pub fn pope_2d_score(
  q : Array[Double],
  k : Array[Double],
  delta : Int32,
  theta : Double,
) -> Double {
  let nq = (q[0] * q[0] + q[1] * q[1]).sqrt()
  let nk = (k[0] * k[0] + k[1] * k[1]).sqrt()
  softplus(nq) * softplus(nk) * @math.cos(delta.to_double() * theta)
}

// ---------------------------------------------------------------------------
// Shared spectral-triple algorithms
// ---------------------------------------------------------------------------

///|
pub fn[T : PosKernel] kernel_gram(k : T, len : Int32) -> Array[Double] {
  Array::makei(len * len, fn(t) { k.eval(t / len - t % len) })
}

///|
pub fn largest_eigenvalue_power(
  a : Array[Double],
  n : Int32,
  iters : Int32,
) -> Double {
  let raw = Array::makei(n, fn(i) { @math.sin(0.7 * (i + 1).to_double()) })
  let mut v = vec_scale(raw, 1.0 / dot(raw, raw).sqrt())
  let mut lambda = 0.0
  for _ in 0..<iters {
    let w = matvec(a, v, n)
    let norm = dot(w, w).sqrt()
    if norm == 0.0 {
      return 0.0
    }
    v = vec_scale(w, 1.0 / norm)
    lambda = dot(v, matvec(a, v, n))
  }
  lambda
}

///|
/// Smallest eigenvalue of a symmetric Gram matrix via shift + power iteration.
/// PSD iff λ_min >= -tol.
pub fn gram_min_eigenvalue(a : Array[Double], n : Int32) -> Double {
  let c = mat_inf_norm(a, n) + 1.0
  let shifted = Array::makei(n * n, fn(t) {
    let diag = if t / n == t % n { c } else { 0.0 }
    diag - a[t]
  })
  c - largest_eigenvalue_power(shifted, n, 200)
}

///|
pub fn gram_is_toeplitz(a : Array[Double], n : Int32) -> Bool {
  for i in 0..<n {
    for j in 0..<n {
      for p in 0..<n {
        for q in 0..<n {
          if i - j == p - q && !approx(a[i * n + j], a[p * n + q], tol=1.0e-12) {
            return false
          }
        }
      }
    }
  }
  true
}

///|
test "T7(L): Favard recurrence, Gauss-Legendre quadrature, orthogonality" {
  // three-term recurrence exactly reproduces P_3(x) = (5x^3-3x)/2
  let c3 = legendre_coeffs(3)
  assert_eq(c3.length(), 4)
  assert_true(approx(c3[1], -1.5))
  assert_true(approx(c3[3], 2.5))
  assert_true(approx(legendre(3, 1.0), 1.0))
  assert_true(approx(legendre(4, 0.5), -0.2890625, tol=1.0e-12))
  let q = gauss_legendre(6)
  // Σ w_i = 2, nodes inside (-1,1)
  let mut sw = 0.0
  for w in q.weights {
    sw += w
  }
  assert_true(approx(sw, 2.0, tol=1.0e-10))
  for a in 0..<6 {
    for b in 0..<6 {
      let expected = if a == b { 2.0 / (2 * a + 1).to_double() } else { 0.0 }
      assert_true(
        approx(legendre_gram(a, b, q), expected, tol=1.0e-9),
        msg="Legendre orthogonality",
      )
    }
  }
}

///|
test "T7(L): Jacobi spectrum = roots of P_N" {
  let n = 5
  let j = legendre_jacobi(n)
  let q = gauss_legendre(n)
  for x in q.nodes {
    assert_true(
      approx(char_poly_at(j, n, x), 0.0, tol=1.0e-8),
      msg="Jacobi eigenvalue equals Gauss node",
    )
  }
  // PoPE-L encoding has full dimension d and is deterministic
  let e = pope_legendre_encoding(3, 8)
  assert_eq(e.length(), 8)
  assert_true(approx(e[0], legendre(3, -1.0)))
}

///|
test "T7(P): translation equivariance, PSD Gram, what/where decoupling" {
  let k = PolarPoPE::new(8, 0.6)
  let gram = kernel_gram(k, 6)
  assert_true(gram_is_toeplitz(gram, 6))
  assert_true(gram_min_eigenvalue(gram, 6) > -1.0e-9)
  let qmag = Array::makei(8, fn(i) { softplus((i + 1).to_double() * 0.1) })
  let kmag = Array::makei(8, fn(i) { softplus((8 - i).to_double() * 0.12) })
  let bias = Array::make(8, 0.0)
  let a = pope_score(qmag, kmag, 3, 0.6, bias)
  let b = pope_score(qmag, kmag, -3, 0.6, bias)
  // with zero bias the kernel is even in the offset
  assert_true(approx(a, b, tol=1.0e-12))
  // RoPE entangles content phase; PoPE does not
  let q1 = [1.0, 0.0]
  let q2 = [0.0, 1.0] // same norm, different content phase
  let key = [2.0, 0.0]
  let r1 = rope_2d_score(q1, key, 2, 0.6)
  let r2 = rope_2d_score(q2, key, 2, 0.6)
  assert_true((r1 - r2).abs() > 0.1)
  assert_true(
    approx(pope_2d_score(q1, key, 2, 0.6), pope_2d_score(q2, key, 2, 0.6)),
  )
}

///|
test "T7: both PoPE variants are spectral triples with PSD kernels" {
  let lp = LegendrePoPE::{ dim: 8, }
  let gp = kernel_gram(lp, 5)
  assert_true(gram_min_eigenvalue(gp, 5) > -1.0e-9)
  assert_true(gram_is_toeplitz(gp, 5))
  assert_eq(lp.eval(0), 2.0)
  assert_eq(lp.eval(1), 0.0)
}
